{
  "id": "themoviedb",
  "name": "TMDB 影视数据",
  "description": "从 The Movie Database 拉取海报、简介、评分、趋势与榜单",
  "version": "1.0.1",
  "author": "REX",
  "origin": "official",
  "engines": { "rex": ">=1.0.0" },
  "capabilities": ["metadata_source", "catalog_source"],
  "icon": "movie_filter_outlined",
  "accent": "#01B4E4",
  "permissions": ["network"],
  "config_schema": [
    {
      "key": "api_key",
      "type": "secret",
      "label": "API Key",
      "hint": "v3 auth key",
      "required": true,
      "help_url": "https://www.themoviedb.org/settings/api",
      "help_label": "获取 API Key"
    },
    {
      "key": "language",
      "type": "enum",
      "label": "请求语言",
      "default": "zh-CN",
      "options": [
        { "value": "zh-CN", "label": "简体中文" },
        { "value": "zh-TW", "label": "繁体中文" },
        { "value": "en-US", "label": "English" },
        { "value": "ja-JP", "label": "日本語" },
        { "value": "ko-KR", "label": "한국어" }
      ]
    },
    {
      "key": "region",
      "type": "enum",
      "label": "地区",
      "default": "CN",
      "options": [
        { "value": "CN", "label": "中国大陆" },
        { "value": "HK", "label": "香港" },
        { "value": "TW", "label": "台湾" },
        { "value": "US", "label": "美国" },
        { "value": "JP", "label": "日本" },
        { "value": "KR", "label": "韩国" }
      ]
    },
    {
      "key": "include_adult",
      "type": "enum",
      "label": "成人内容",
      "default": "false",
      "options": [
        { "value": "false", "label": "不包含" },
        { "value": "true", "label": "包含" }
      ]
    }
  ]
}
