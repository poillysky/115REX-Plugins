{
  "id": "themoviedb",
  "name": "TMDB 影视数据",
  "description": "从 The Movie Database 拉取海报、简介与评分",
  "version": "1.0.0",
  "origin": "official",
  "engines": { "rex": ">=1.0.0" },
  "capabilities": ["metadata_source"],
  "icon": "movie_filter_outlined",
  "accent": "#6366F1",
  "permissions": ["network"],
  "config_schema": [
    {
      "key": "api_key",
      "type": "secret",
      "label": "API Key",
      "hint": "themoviedb.org → Settings → API → API Key (v3)",
      "required": true
    },
    {
      "key": "language",
      "type": "enum",
      "label": "请求语言",
      "default": "zh-CN",
      "options": [
        { "value": "zh-CN", "label": "简体中文" },
        { "value": "zh-TW", "label": "繁体中文" },
        { "value": "en-US", "label": "English" },
        { "value": "ja-JP", "label": "日本語" }
      ]
    }
  ]
}
